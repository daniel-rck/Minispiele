{
  "name": "minispiele",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "65 Browser-Minispiele. Lokal, ohne Account, ohne Tracking.",
  "homepage": "https://minispiele.daniel-rck.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-rck/Minispiele.git"
  },
  "bugs": {
    "url": "https://github.com/daniel-rck/Minispiele/issues"
  },
  "author": "Daniel Rück",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "keywords": [
    "games",
    "minispiele",
    "browser-games",
    "pwa",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "analyze": "vite build && open dist/stats.html",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "prepare": "simple-git-hooks || true",
    "lint": "biome check ."
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,html,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.4.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.39.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@fontsource/nunito": "^5.3.0",
    "@playwright/test": "^1.49.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.10.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.0",
    "rolldown": "^1.0.2",
    "rollup-plugin-visualizer": "^7.0.0",
    "simple-git-hooks": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.0",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.128.0"
  },
  "webBase": {
    "version": "0.3.1"
  }
}
