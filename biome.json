{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "extends": ["./biome.base.json"],
  "files": {
    "includes": [
      "!**/dist",
      "!**/dev-dist",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/playwright-report",
      "!**/test-results",
      "!**/public",
      "!**/todo"
    ]
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.generated.ts"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/*Game.tsx",
        "src/components/DiceRoller.tsx",
        "src/components/TimerDisplay.tsx",
        "src/components/SettingsSheet.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          },
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
